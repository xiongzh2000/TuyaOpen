config ENABLE_WIFI
    bool
    default y

config ENABLE_BLUETOOTH
    bool
    select ENABLE_BT_SERVICE
    select ENABLE_NIMBLE
    # ESP32-P4 has no local BT controller (WiFi/BT are on the external C6
    # coprocessor). Enabling BLE here makes BLE-netcfg the default, which fails
    # on P4 and prevents the app from being discovered. Default to WiFi-only
    # netcfg on P4, same as switch_demo.
    default n if BOARD_CHOICE_ESP32_P4_C6
    default n if BOARD_CHOICE_WAVESHARE_ESP32P4_TOUCH_LCD_4_3
    default y

config ENABLE_ADC
    bool
    default y

config ENABLE_GPIO
    bool
    default y

config ENABLE_UART
    bool
    default y

config ENABLE_PWM
    bool
    default y

config ENABLE_I2C
    bool
    default y

config ENABLE_I2S
    bool
    default y

config ENABLE_TIMER
    bool
    default y

config ENABLE_WATCHDOG
    bool
    default y

config ENABLE_AUDIO
    bool
    default n

config ENABLE_VIDEO
    bool
    default n

config ENABLE_EXT_RAM
    bool
    default n

config ENABLE_ESP_DISPLAY
    bool
    default n
    
if (ENABLE_ESP_DISPLAY)
    config DISPLAY_NAME
        string "the name of display 1"
        default "display"
endif

config LITTLE_END
    int
    default 1
    ---help---
        0       /* big endian */
        1       /* little endian */
